{
  "name": "openclaw-electron",
  "private": true,
  "version": "0.1.0",
  "description": "OpenClaw Electron desktop client",
  "type": "commonjs",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "concurrently -k \"tsup --watch\" \"pnpm --filter openclaw-control-ui-react dev\" \"sleep 6 && VITE_UI_REACT_URL=http://localhost:5174 electron .\"",
    "dev:static": "concurrently -k \"tsup --watch\" \"sleep 3 && electron .\"",
    "package": "pnpm build && electron-builder",
    "package:mac": "pnpm build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.x",
    "concurrently": "^9.1.2",
    "electron": "31.7.7",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.2.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3"
  }
}
