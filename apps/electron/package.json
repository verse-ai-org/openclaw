{
  "name": "openclaw-electron",
  "private": true,
  "version": "2026.4.5",
  "description": "OpenClaw Electron desktop client",
  "author": "OpenClaw Team",
  "type": "commonjs",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.electron.ts",
    "prepackage": "pnpm --filter openclaw-control-ui-react build",
    "dev": "concurrently -k \"tsdown --config-loader unrun --config tsdown.config.electron.ts --watch\" \"pnpm --filter openclaw-control-ui-react dev\" \"sleep 6 && cross-env VITE_UI_REACT_URL=http://localhost:5174 electron .\"",
    "dev:static": "concurrently -k \"tsdown --config-loader unrun --config tsdown.config.electron.ts --watch\" \"sleep 3 && electron .\"",
    "package": "pnpm build && electron-builder",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.469.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.x",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "31.7.7",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.2.1",
    "tsdown": "0.21.0",
    "typescript": "^5.8.3"
  }
}
