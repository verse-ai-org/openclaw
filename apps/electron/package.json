{
  "name": "openclaw-electron",
  "private": true,
  "version": "2026.6.11",
  "description": "OpenClaw Electron desktop client",
  "author": "OpenClaw Team",
  "type": "commonjs",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.electron.ts",
    "prepackage": "pnpm --filter openclaw-control-ui-react build",
    "patch:electron-plist": "node scripts/patch-electron-dev-plist.cjs",
    "dev": "node scripts/patch-electron-dev-plist.cjs && concurrently -k \"tsdown --config-loader unrun --config tsdown.config.electron.ts --watch\" \"cross-env VITE_GATEWAY_PORT=18790 VITE_BOSSIM_SERVICE_URL=http://localhost:8080 pnpm --filter openclaw-control-ui-react dev\" \"sleep 6 && cross-env VITE_UI_REACT_URL=http://localhost:5174 VITE_GATEWAY_PORT=18790 BOSSIM_BFF_URL=http://localhost:3000 BOSSIM_AUTH_APP_URL=http://localhost:3000/auth/app BOSSIM_SERVICE_URL=http://localhost:8080 electron .\"",
    "dev:static": "concurrently -k \"tsdown --config-loader unrun --config tsdown.config.electron.ts --watch\" \"sleep 3 && electron .\"",
    "package": "pnpm build && electron-builder",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps && node scripts/patch-electron-dev-plist.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.469.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.x",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "42.2.0",
    "electron-builder": "^26.8.1",
    "rcedit": "^4.0.1",
    "tailwindcss": "^4.2.1",
    "tsdown": "0.21.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3"
  }
}
