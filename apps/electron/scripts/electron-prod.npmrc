# Used only for apps/electron/resources/prod-node_modules (pnpm install --prod).
#
# electron-builder copies dependency trees as real directories and does not preserve
# pnpm's symlink layout into .pnpm. A copied @mariozechner/pi-ai tree then lacks
# nested deps (e.g. @google/genai), and Node fails with ERR_MODULE_NOT_FOUND.
# Hoisted node_modules keeps transitive packages at the root node_modules so resolution
# still works after packaging.
node-linker=hoisted
