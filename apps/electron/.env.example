# macOS 签名 & 公证所需环境变量
# 复制此文件为 .env，填入真实值，.env 已被 .gitignore 忽略
#
# 获取方式：
#   ISSUER_ID / KEY_ID：App Store Connect → Users and Access → Integrations → API Keys
#   API_KEY_P8：下载的 .p8 文件完整内容（含 BEGIN/END 行）
#   TEAM_ID：developer.apple.com/account → Membership 页面，或 Keychain 中证书名的括号部分

APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_TEAM_ID=XXXXXXXXXX

# 方式一（推荐）：指定 .p8 文件路径，由打包脚本读取文件内容
APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# 方式二：直接粘贴 .p8 文件内容（多行，保留换行）
# APP_STORE_CONNECT_API_KEY_P8="-----BEGIN PRIVATE KEY-----
# MIGHAgEAMBMG...
# -----END PRIVATE KEY-----"
