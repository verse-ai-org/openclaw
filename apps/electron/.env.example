# macOS 签名 & 公证所需环境变量
# 复制此文件为 .env，填入真实值，.env 已被 .gitignore 忽略
#
# 获取方式：
#   ISSUER_ID / KEY_ID：App Store Connect → Users and Access → Integrations → API Keys
#   API_KEY_P8：下载的 .p8 文件完整内容（含 BEGIN/END 行）
#   TEAM_ID：developer.apple.com/account → Membership 页面，或 Keychain 中证书名的括号部分

# APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
# APP_STORE_CONNECT_TEAM_ID=XXXXXXXXXX

# # 方式一（推荐）：指定 .p8 文件路径，由打包脚本读取文件内容
# APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# # 方式二：直接粘贴 .p8 文件内容（多行，保留换行）
# # APP_STORE_CONNECT_API_KEY_P8="-----BEGIN PRIVATE KEY-----
# # MIGHAgEAMBMG...
# # -----END PRIVATE KEY-----"

# # ── Cloudflare R2 上传配置（make upload-r2 / make release 使用）──────────────
# # R2 Access Key ID 和 Secret（在 Cloudflare 控制台 R2 → Manage R2 API tokens 创建）
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxx
# # R2 Secret Access Key
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# # R2 Endpoint URL (format: https://<account_id>.r2.cloudflarestorage.com)
# R2_ENDPOINT=https://xxxxxxx.r2.cloudflarestorage.com
# # R2 Bucket 名称
# R2_BUCKET_NAME=xxxxxxxxxx
# # R2 公开访问域名（可选，用于自定义域名或 CDN）
# # 例如：https://cdn.yourdomain.com 或 https://pub-xxxx.r2.dev
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL=xxxxxxxxxxx

# macOS 签名 & 公证所需环境变量
# 复制此文件为 .env，填入真实值，.env 已被 .gitignore 忽略
#
# 获取方式：
#   ISSUER_ID / KEY_ID：App Store Connect → Users and Access → Integrations → API Keys
#   API_KEY_P8：下载的 .p8 文件完整内容（含 BEGIN/END 行）
#   TEAM_ID：developer.apple.com/account → Membership 页面，或 Keychain 中证书名的括号部分

APP_STORE_CONNECT_ISSUER_ID=ea28a93d-c801-40f8-a977-a852359700fe
APP_STORE_CONNECT_KEY_ID=8H77P47ZP4
APP_STORE_CONNECT_TEAM_ID=CBFA4655YD

# 方式一（推荐）：指定 .p8 文件路径，由打包脚本读取文件内容
APP_STORE_CONNECT_API_KEY_PATH=/Users/heyuan/Workspace/apple/AuthKey_8H77P47ZP4.p8

# 方式二：直接粘贴 .p8 文件内容（多行，保留换行）
# APP_STORE_CONNECT_API_KEY_P8="-----BEGIN PRIVATE KEY-----
# MIGHAgEAMBMG...
# -----END PRIVATE KEY-----"


# ── Cloudflare R2 上传配置（make upload-r2 / make release 使用）──────────────
# R2 Access Key ID 和 Secret（在 Cloudflare 控制台 R2 → Manage R2 API tokens 创建）
R2_ACCESS_KEY_ID=efa014c84810d89c3edadf23a00eac07
# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=a3cf8e8fc198d251bd566e80bf6accf14323b4c6ef66b130e62f6a50fc66e4f2
# R2 Endpoint URL (format: https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://f3add25f595daf0c1deda724c8c7ac45.r2.cloudflarestorage.com
# R2 Bucket 名称
R2_BUCKET_NAME=aiverse-storage
# R2 公开访问域名（可选，用于自定义域名或 CDN）
# 例如：https://cdn.yourdomain.com 或 https://pub-xxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://files.aiverser.com

# ── Windows Authenticode 代码签名（make package-win / electron-builder --win）────────
# 证书：从 CA 购买的 Code Signing 证书导出为 .pfx（含私钥），勿提交仓库。
# electron-builder 文档：https://www.electron.build/code-signing-win
#
# 推荐：在 apps/electron/.env 中设置（已由 package-electron-win.sh 的 load_env 自动 source）
#
# CSC_LINK：.pfx 文件的绝对路径，或 https URL（CI 里常见）
# CSC_KEY_PASSWORD：导出 .pfx 时设置的密码
# （仅打 Windows 安装包时也可用 WIN_CSC_LINK / WIN_CSC_KEY_PASSWORD，与上二选一即可）
#
# CSC_LINK=C:/certs/your-company-signing.pfx
# CSC_KEY_PASSWORD=your-pfx-password
#
# 交叉编译说明：在 macOS/Linux 上打 Windows 包时，electron-builder 可能依赖自带 win 签名工具链；
# 若签名失败，优先在 Windows runner（如 GitHub Actions windows-latest）上执行打包并注入上述变量。
#
# 可选：在 electron-builder.yml 根级设置 forceCodeSigning: true，未配置证书时打包失败（默认 false 则跳过签名仍能出包）
