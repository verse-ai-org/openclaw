# macOS 签名 & 公证所需环境变量
# 复制此文件为 .env，填入真实值，.env 已被 .gitignore 忽略
#
# 获取方式：
#   ISSUER_ID / KEY_ID：App Store Connect → Users and Access → Integrations → API Keys
#   API_KEY_P8：下载的 .p8 文件完整内容（含 BEGIN/END 行）
#   TEAM_ID：developer.apple.com/account → Membership 页面，或 Keychain 中证书名的括号部分

APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX
APP_STORE_CONNECT_TEAM_ID=XXXXXXXXXX

# 方式一（推荐）：指定 .p8 文件路径，由打包脚本读取文件内容
APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# 方式二：直接粘贴 .p8 文件内容（多行，保留换行）
# APP_STORE_CONNECT_API_KEY_P8="-----BEGIN PRIVATE KEY-----
# MIGHAgEAMBMG...
# -----END PRIVATE KEY-----"

# ── Cloudflare R2 上传配置（make upload-r2 / make release 使用）──────────────
# R2 Access Key ID 和 Secret（在 Cloudflare 控制台 R2 → Manage R2 API tokens 创建）
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxx
# R2 Secret Access Key
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2 Endpoint URL (format: https://<account_id>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://xxxxxxx.r2.cloudflarestorage.com
# R2 Bucket 名称
R2_BUCKET_NAME=xxxxxxxxxx
# R2 公开访问域名（可选，用于自定义域名或 CDN）
# 例如：https://cdn.yourdomain.com 或 https://pub-xxxx.r2.dev
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=xxxxxxxxxxx
